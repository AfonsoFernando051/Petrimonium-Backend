# Copy this file to `.env` (git-ignored) and fill in real values for local
# development. In CI/production, set these as real environment variables
# instead — `.env` is a local-dev convenience only. See DotenvLoader.

# Required for local development: application.properties (the base config,
# always loaded) no longer carries dev-permissive defaults itself (H2, CORS
# wildcard, seed data) — those now live in application-dev.properties,
# active only when this is set. Without it, the app has no datasource
# configured and fails to start — this is deliberate, see
# application.properties' header comment. Never set this in a real
# deployment; production sets spring.profiles.active=prod instead (already
# baked into the Dockerfile as the SPRING_PROFILES_ACTIVE env var).
spring.profiles.active=dev

# HS256 signing key for JWTs — generate your own, e.g.: openssl rand -base64 48
jwt.secret=

# Comma-separated OAuth 2.0 Client IDs from https://console.cloud.google.com/apis/credentials
# (Android client ID + Web client ID used as serverClientId on mobile) for "Sign in with
# Google". Leave blank to disable Google login locally.
google.oauth.client-ids=

# https://brapi.dev — leave blank to fall back to mock quote data locally.
api.brapi.token=

# https://libretranslate.com — leave blank to skip translation (content stays pt-BR).
api.libretranslate.key=

# https://console.anthropic.com — the AI Investment Mentor's primary chat provider
# (see docs/AI_MENTOR.md). Leave blank to fall through to Gemini below.
api.anthropic.key=

# https://ai.google.dev — the Mentor's fallback provider if the Anthropic call fails.
# Leave both this and api.anthropic.key blank to get the mentor's friendly "I'm having
# trouble thinking" canned reply instead.
api.gemini.key=

# SMTP credentials for the forgot-password flow. Leave blank locally — the reset code is
# logged to the console instead of emailed (see JavaMailPasswordResetMailerAdapter).
spring.mail.host=
spring.mail.port=
spring.mail.username=
spring.mail.password=
# "From" address used on outgoing password-reset emails.
app.mail.from=
