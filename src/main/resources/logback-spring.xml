<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!--
        Two shapes for the same log stream: JSON in prod (machine-parseable, feeds a log
        aggregator), a readable pattern everywhere else. Both include the request correlation
        id RequestIdFilter puts in MDC (see infrastructure/security/RequestIdFilter.java) so a
        single request's log lines can be tied together.
    -->
    <springProfile name="prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeMdcKeyName>requestId</includeMdcKeyName>
            </encoder>
        </appender>
    </springProfile>

    <springProfile name="!prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%X{requestId}] %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>
    </springProfile>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
