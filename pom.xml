			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-resttestclient</artifactId>
			<scope>test</scope>
		</dependency>
		<!--
			Enforces the simulated_portfolio / real_portfolio module boundary at compile-test time
			(docs/BACKEND_MODULE_PLAN.md §4's dependency-rule proposal, scoped narrowly to the one
			boundary that already needs it rather than waiting for the full package restructuring) —
			see SimulatedPortfolioBoundaryTest.
		-->
		<dependency>
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit-junit5</artifactId>
			<version>1.3.0</version>
			<scope>test</scope>
		</dependency>
		<!--
			Not test-scoped: RestTemplateBuilder (org.springframework.boot.restclient) — used by
			HttpClientConfig to give every outbound HTTP client a bounded timeout — lives here in
			Boot 4's restructured modules, not in spring-boot-webmvc.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-restclient</artifactId>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</path>
						<path>
							<groupId>org.springframework.boot</groupId>
							<artifactId>spring-boot-configuration-processor</artifactId>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
			<!--
				Not bound to any lifecycle phase on purpose: scanning against the NVD feed is
				slow and needs network access, so it shouldn't run on every local `mvn test`.
				Run explicitly with `mvn org.owasp:dependency-check-maven:check`, e.g. as a
				dedicated (non-blocking) CI step.
			-->
			<plugin>
				<groupId>org.owasp</groupId>
				<artifactId>dependency-check-maven</artifactId>
				<version>12.1.0</version>
			</plugin>
			<!--
				Mutation testing, scoped to the business-logic layers (application use cases/
				services and core domain) rather than the whole codebase: infrastructure
				adapters/entities/DTOs/config are data-shaped or framework-wired, not decision
				logic, so mutating them mostly produces equivalent-mutant noise instead of a
				meaningful signal. Not bound to a lifecycle phase — run explicitly with
				`mvn org.pitest:pitest-maven:mutationCoverage`, e.g. as a dedicated, blocking CI
				step (see .github/workflows/backend-ci.yml). Thresholds are set just under the
				measured baseline (78% mutation / 88% line coverage on this scope as of the pass
				that introduced this plugin) so the gate is real rather than trivially satisfied;
				revisit upward as new tests raise the baseline further.
			-->
			<plugin>
				<groupId>org.pitest</groupId>
				<artifactId>pitest-maven</artifactId>
				<version>1.17.4</version>
				<dependencies>
					<dependency>
						<groupId>org.pitest</groupId>
						<artifactId>pitest-junit5-plugin</artifactId>
						<version>1.2.2</version>
					</dependency>
				</dependencies>
				<configuration>
					<targetClasses>
						<param>com.jf.PetApp.application.*</param>
						<param>com.jf.PetApp.core.domain.*</param>
					</targetClasses>
					<targetTests>
						<param>com.jf.PetApp.application.*</param>
						<param>com.jf.PetApp.core.domain.*</param>
					</targetTests>
					<excludedClasses>
						<param>com.jf.PetApp.application.*.dto.*</param>
						<param>com.jf.PetApp.application.*.port.*</param>
					</excludedClasses>
					<mutationThreshold>70</mutationThreshold>
					<coverageThreshold>80</coverageThreshold>
					<timestampedReports>false</timestampedReports>
					<outputFormats>
						<outputFormat>HTML</outputFormat>
						<outputFormat>XML</outputFormat>
					</outputFormats>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
